{
  "type": "origins:multiple",
  "activate": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "gate:dashstorm_trigger",
      "operation": "set",
      "change": 1
    },
    "cooldown": 100,
    "key": {
      "key": "key.origins.secondary_active"
    }
  },
  "activateCooldown": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "gate:dashstorm_cooldown",
      "operation": "set",
      "change": 0
    },
    "cooldown": 100,
    "key": {
      "key": "key.origins.secondary_active"
    }
  },
  "trigger": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
    "degrade": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "gate:dashstorm_cooldown",
            "operation": "add",
            "change": 1
        },
        "condition": {
            "type": "origins:resource",
            "resource": "gate:dashstorm_cooldown",
            "compare_to": 100,
            "comparison": "<"
        }
    },

  "cooldown": {
    "type": "origins:resource",
    "min": 0,
    "max": 100,
    "start_value": 100,
    "hud_render": {
      "should_render": true,
      "bar_index": 3
    }
  },
  "name": "Dash Storm",
  "description": "Dash forward 25 blocks with the power of lightning."
}
