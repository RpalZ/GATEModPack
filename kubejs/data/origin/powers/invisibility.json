{
  "type": "origins:multiple",

  "invisible": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "gate:invisibility_timer",
      "operation": "set",
      "change": 400
    },
    "cooldown": 600,
    "key": {
      "key": "key.origins.primary_active"
    }
  },

  "timer": {
    "type": "origins:resource",
    "min": 0,
    "max": 400,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "bar_index": 4,
      "icon_index": 5,
      "condition": {
        "type": "origins:resource",
        "resource": "gate:invisibility_timer",
        "compare_to": 0,
        "comparison": ">"
      }
    }
  },
  "degrade": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "gate:invisibility_timer",
      "operation": "add",
      "change": -1
    },
    "condition": {
      "type": "origins:resource",
      "resource": "gate:invisibility_timer",
      "compare_to": 0,
      "comparison": ">"
    }
  },
  "invisibility": {
    "type": "origins:invisibility",
    "render_armor": false,
    "condition": {
      "type": "origins:resource",
      "resource": "gate:invisibility_timer",
      "compare_to": 0,
      "comparison": ">"
    }
  },
  "name": "Nature's Veil",
  "description": "Become invisible for 20 seconds."
}
