	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"&8&6For generations, the world was torn by the Great War. But then, from the Void, a mindless horror emerged. An anomaly dubbed 'the Warden' brought forth a Miasma that threatens to consume us all.&r"
				"&r"
				"&o&6Forced to unite against this threat, the ruling factions signed the Pact of the Gate. The United Council tasks you, an Envoy of this fragile truce, to master the foundational mechanics and magics scattered across the horizon. Push back the Miasma, and search for clues in its wake.&r&r"
				""
				"&4&o\"The Void spawn is mindless, but the Miasma is relentless. The Pact is our only shield.\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "iceandfire:dread_portal"
			id: "46B96E1D0D8B7BCA"
			shape: "hexagon"
			size: 3.0d
			tasks: [{
				id: "11A022A00DBEAE16"
				title: "The Great War"
				type: "checkmark"
			}]
			x: -0.5d
			y: -5.0d
		}
		{
			dependencies: ["46B96E1D0D8B7BCA"]
			description: [
				"&6&oIf we are to stand against what waits beyond the Gate, strength cannot be borrowed forever. Each warrior must prove they can carry their own weight so the whole can endure as one. Hunt down the traitors of the Pact and claim the first key to the source of this corruption.&r&r"
				""
				"&4&o\"Begin with the broken remnants of the old war. Power is forged in the first victory.\"&r&r"
			]
			entity_vis_size: 1.0f
			id: "79F4974E23BC93AA"
			rewards: [{
				auto: "enabled"
				id: "54817231C4FAF88E"
				item: {
					Count: 1
					id: "endrem:corrupted_eye"
