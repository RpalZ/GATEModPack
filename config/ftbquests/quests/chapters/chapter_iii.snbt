	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: ["7978A173146F39D6"]
			description: [
				"&6&oThe final path begins where the worlds thin out. The Gate has been reached, but the silence beyond it feels less like peace and more like something holding its breath.&r&r"
				""
				"&4&o\"If the trail ends here, then whatever waits beyond has been waiting for us.\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "iceandfire:dread_portal"
			id: "61CA71F2A65B0171"
			shape: "hexagon"
			size: 3.0d
			tasks: [{
				id: "5DB44384BA783EB9"
				title: "Final Step"
				type: "checkmark"
			}]
			x: 1.5d
			y: -4.875d
		}
		{
			dependencies: ["61CA71F2A65B0171"]
			description: [
				"&6&oAt last, the End itself opens before you. The air is still, the ground is silent, and the sky is wrong, as if the world has been stripped down to its bones.&r&r"
				""
				"&4&o\"There is no turning back now.\"&r&r"
			]
			entity_vis_size: 1.0f
			id: "5E66F197D6DA73F9"
			rewards: [
				{
					id: "0A143364C101F73C"
					type: "xp"
					xp: 5000
				}
				{
					auto: "invisible"
					id: "34F0B98E5641CC36"
					ignore_reward_blocking: true
					stage: "quest_5e66f197d6da73f9"
					type: "gamestage"
				}
			]
			size: 1.5d
			tasks: [{
				dimension: "minecraft:the_end"
				id: "5A74B5D2B6A4FAEB"
				type: "dimension"
			}]
			x: 8.625d
			y: 0.75d
		}
		{
			dependencies: ["5E66F197D6DA73F9"]
			description: [
				"&6&oThe dragon falls, but victory here feels incomplete. The End does not empty so easily, and its shadows still cling to the broken islands like a warning left unfinished. Even so, its hoard should spill open for those who survive the fight.&r&r"
				""
				"&4&o\"A slain dragon leaves behind more than bones if the hunt was worthy.\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:dragon_head"
			id: "023B9345FAF2ABCC"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "360D65F3C1D10593"
					table_id: 7875281910250566405L
					type: "all_table"
				}
				{
					auto: "invisible"
					id: "20E7ECC37262A5A0"
					ignore_reward_blocking: true
					stage: "ender_dragon"
					type: "gamestage"
				}
			]
			size: 1.5d
			tasks: [{
				entity: "minecraft:ender_dragon"
				entity_use_tag: false
				entity_vis_idle_mode: "USE_GLOBAL"
				entity_vis_offset_x: 0.0f
				entity_vis_offset_y: 0.0f
				entity_vis_rotation: 0.0f
				entity_vis_silhouette_mode: "NONE"
				entity_vis_size: 1.0f
				entity_vis_spin_mode: "USE_GLOBAL"
				entity_vis_use_as_quest_icon: false
				entity_vis_walk_mode: "USE_GLOBAL"
				icon: "minecraft:dragon_breath"
				id: "6E56CD7ACDB7CC7F"
				type: "kill"
				value: 1L
			}]
			x: -4.5d
			y: 1.875d
		}
		{
			dependencies: ["023B9345FAF2ABCC"]
			description: [
				"&6&oThe first thing that answers the dragon's fall is a guardian born of harsher ruin. It moves like a fortress with a heartbeat, and the End seems to recoil wherever it walks.&r&r"
				""
				"&4&o\"The End is still hiding its teeth.\"&r&r"
			]
			entity_vis_size: 1.0f
			icon: "minecraft:shulker_box"
			id: "69712D8B4DFADE6C"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "20184AA503448042"
